{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist/app",
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["src/**/*.ts"]
}
